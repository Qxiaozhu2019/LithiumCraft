APP_ENV=production
API_PREFIX=/api/v1

POSTGRES_DB=lithiumcraft
POSTGRES_USER=lithiumcraft
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://lithiumcraft:replace-with-a-strong-postgres-password@postgres:5432/lithiumcraft

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Use the ECS public IP first. Replace with your domain after DNS is ready.
CORS_ORIGINS=http://139.224.223.234
CRAWLER_USER_AGENT=LithiumCraftBot/0.1 (+http://139.224.223.234; compliance contact: ops@example.com)

DEFAULT_DOMAIN_DELAY_SECONDS=3
DEFAULT_DAILY_LIMIT=100

VITE_API_BASE=/api/v1

AI_PROVIDER=stub
AI_API_KEY=

# Direct public HTTP: bind 0.0.0.0:80.
# BaoTa/host Nginx reverse proxy: set PUBLIC_HTTP_BIND=127.0.0.1 and PUBLIC_HTTP_PORT=8080.
PUBLIC_HTTP_BIND=0.0.0.0
PUBLIC_HTTP_PORT=80

CELERY_APP_MODULE=app.tasks.celery_app:celery_app
CELERY_LOG_LEVEL=info

BACKUP_DIR=deploy/backups
